{
  "name": "prosazhin.ru",
  "description": "Personal site",
  "repository": {
    "type": "git",
    "url": "https://github.com/prosazhin/prosazhinru.git"
  },
  "author": "Evgenii Sazhin <prosazhin@gmail.com> (https://prosazhin.ru)",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "next lint --no-cache",
    "format": "prettier --write \"**/*.{js,json}\"",
    "prepare": "npx simple-git-hooks",
    "text-local-build": "npm run build && npx next start -p 4000"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged --concurrent false",
    "pre-push": "npm run format",
    "commit-msg": "npx --no-install commitlint --edit ${1}"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": "prettier --write"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@pbcomponents/react": "^0.0.13",
    "contentful": "11.2.5",
    "dayjs": "1.11.13",
    "globals": "^15.12.0",
    "i18next": "^24.0.2",
    "i18next-resources-to-backend": "^1.2.1",
    "mixpanel-browser": "2.56.0",
    "next": "^14.2.18",
    "next-i18n-router": "^5.5.1",
    "next-sitemap": "^4.2.3",
    "numeralize-ru": "^2.0.0",
    "pbstyles": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.2",
    "react-use": "^17.5.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.15",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "eslint-config-next": "^14.2.18",
    "eslint-config-prettier": "^9.1.0",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.49",
    "prettier": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^3.4.15"
  }
}
