{
  "name": "prosazhin.ru",
  "description": "Personal site",
  "repository": {
    "type": "git",
    "url": "https://github.com/prosazhin/prosazhinru.git"
  },
  "author": "Evgenii Sazhin <prosazhin@gmail.com> (https://prosazhin.ru)",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint . --no-warn-ignored",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,json,html,css}\"",
    "prepare": "npx simple-git-hooks",
    "text-local-build": "npm run build && npx next start -p 4000"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged --concurrent false",
    "commit-msg": "npx --no-install commitlint --edit ${1}"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,json,html,css}": "prettier --write",
    "*.{ts,tsx}": "eslint --max-warnings=0 --cache --fix --no-warn-ignored"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@pbcomponents/react": "^0.1.5",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "contentful": "11.10.2",
    "dayjs": "1.11.19",
    "globals": "^17.1.0",
    "i18next": "^25.8.0",
    "i18next-resources-to-backend": "^1.2.1",
    "mixpanel-browser": "2.73.0",
    "next": "^16.1.5",
    "next-i18n-router": "^5.5.6",
    "next-sitemap": "^4.2.3",
    "numeralize-ru": "^2.0.0",
    "pbstyles": "^3.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.3",
    "react-use": "^17.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "eslint-config-next": "^16.1.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "zod": "^3.24.4"
  }
}
