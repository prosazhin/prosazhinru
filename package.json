{
  "name": "prosazhin.ru",
  "description": "Personal site",
  "repository": {
    "type": "git",
    "url": "https://github.com/prosazhin/prosazhinru.git"
  },
  "author": "Evgenii Sazhin <prosazhin@gmail.com> (https://prosazhin.ru)",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' next dev -p 8080 --turbopack --disable-source-maps",
    "dev:webpack": "NODE_OPTIONS='--max-old-space-size=8192' next dev -p 8080 --webpack --disable-source-maps",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' next build",
    "postbuild": "next-sitemap",
    "postinstall": "patch-package",
    "start": "next start",
    "lint": "eslint . --no-warn-ignored",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,json,html,css}\"",
    "prepare": "npx simple-git-hooks",
    "text-local-build": "npm run build && npx next start -p 4000"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged --concurrent false --no-stash",
    "commit-msg": "npx --no-install commitlint --edit ${1}"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,json,html,css}": "prettier --write",
    "*.{ts,tsx}": "eslint --max-warnings=0 --cache --fix --no-warn-ignored"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prosazhin/pbcomponents": "^1.0.2",
    "@prosazhin/pbstyles": "^1.0.0",
    "@react-pdf/renderer": "^4.3.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dayjs": "^1.11.20",
    "globals": "^17.3.0",
    "i18next": "^26.0.1",
    "i18next-resources-to-backend": "^1.2.1",
    "next": "^16.2.3",
    "next-sitemap": "^4.2.3",
    "numeralize-ru": "^2.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.1",
    "react-use": "^17.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "minimatch@3": {
      "brace-expansion": "^1.1.13"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.5"
    },
    "postcss": "^8.5.13",
    "picomatch": "^4.0.4",
    "yaml": "^2.8.3",
    "zod": "^3.24.4"
  }
}
