{
  "name": "prosazhin.ru",
  "description": "Personal site",
  "repository": {
    "type": "git",
    "url": "https://github.com/prosazhin/prosazhinru.git"
  },
  "author": "Evgenii Sazhin <prosazhin@gmail.com> (https://prosazhin.ru)",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "next lint --no-cache",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,json,html,css}\"",
    "prepare": "npx simple-git-hooks",
    "text-local-build": "npm run build && npx next start -p 4000"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged --concurrent false",
    "commit-msg": "npx --no-install commitlint --edit ${1}"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,json,html,css}": "prettier --write",
    "*.{ts,tsx}": "eslint --max-warnings=0 --cache --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@pbcomponents/react": "^0.1.2",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "contentful": "11.5.22",
    "dayjs": "1.11.13",
    "globals": "^16.1.0",
    "i18next": "^25.1.3",
    "i18next-resources-to-backend": "^1.2.1",
    "mixpanel-browser": "2.64.0",
    "next": "^15.3.2",
    "next-i18n-router": "^5.5.2",
    "next-sitemap": "^4.2.3",
    "numeralize-ru": "^2.0.0",
    "pbstyles": "^3.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.1",
    "react-use": "^17.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "eslint-config-next": "^15.3.2",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "simple-git-hooks": "^2.13.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
